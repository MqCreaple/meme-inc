---
import '../styles/global.css';
import { THEMES, ATTRIBUTES } from '../lib/simulation';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Build a meme. Find your people. A playable social-network simulation."
    />
    <title>Meme Inc. — The spread of an idea</title>
  </head>
  <body>
    <header class="masthead">
      <a class="brand" href="/" aria-label="Meme Inc. home">
        <span class="brand-mark">m.</span> MEME INC.{' '}
        <span class="chinese">模因公司</span>
      </a>
      <span class="edition">
        <span class="status-dot"></span> SOCIAL LAB / FIRST DRAFT
      </span>
    </header>
    <main>
      <section class="intro">
        <div>
          <p class="eyebrow">SMALL IDEA. UNPREDICTABLE CONSEQUENCES.</p>
          <h1>
            The spread of an idea<span>.</span>
          </h1>
          <p>Make something worth sharing. See how far it goes.</p>
        </div>
        <div class="round-controls">
          <div class="round-label">
            ROUND <strong id="round">00</strong>
          </div>
          <button
            id="next-round"
            title="Next round (Enter)"
            aria-keyshortcuts="Enter"
            class="primary"
          >
            Next round <span aria-hidden="true">↗</span>
          </button>
        </div>
      </section>
      <section class="metrics" aria-label="Network statistics">
        <div>
          <span>POPULATION</span>
          <strong id="population">300</strong>
          <small>connected people</small>
        </div>
        <div>
          <span>TOTAL REACH</span>
          <strong id="reach">
            0<span>%</span>
          </strong>
          <small id="reach-detail">0 people have seen a meme</small>
        </div>
        <div>
          <span>SHARES THIS ROUND</span>
          <strong id="shares">0</strong>
          <small id="mutation-detail">0 new remixes</small>
        </div>
        <div>
          <span>COMPUTE BUDGET</span>
          <strong id="compute">
            60<span>/100</span>
          </strong>
          <small>+8 every round</small>
        </div>
      </section>
      <div class="workspace">
        <section class="network-panel" aria-labelledby="network-title">
          <div class="panel-heading">
            <div>
              <span class="eyebrow">01 / THE NETWORK</span>
              <h2 id="network-title">Ideas travel through people.</h2>
            </div>
            <span class="tag" id="network-size">
              300 NODES
            </span>
          </div>
          <div class="canvas-wrap">
            <div
              id="network"
              tabindex="0"
              aria-label="Social network. Click a person to inspect them. Use arrow keys to select people, Escape to clear selection, and Enter for the next round."
            ></div>
            <div class="canvas-note">
              <span id="layout-status">Arranging connections…</span>
              <br />
              Click a person to explore <span>·</span> Scroll to zoom{' '}
              <span>·</span> Drag to pan
            </div>
            <div id="canvas-status" class="canvas-status">
              Your network is ready.
              <br />
              Launch a meme to start the chain.
            </div>
          </div>
          <div class="toolbar">
            <label>
              Colour by{' '}
              <select id="colour">
                <option value="interest">Interest</option>
                <option value="preference">Preference</option>
                <option value="memory">Meme memory</option>
              </select>
            </label>
            <label class="toggle">
              <input type="checkbox" id="friend-edges" checked /> Friends
            </label>
            <label class="toggle">
              <input type="checkbox" id="follow-edges" /> Following
            </label>
            <button id="reset-view" class="quiet">
              Reset view ↺
            </button>
          </div>
          <div id="legend" class="legend"></div>
          <div class="activity">
            <div>
              <span class="eyebrow">THE RIPPLE EFFECT</span>
              <h3>Round activity</h3>
            </div>
            <svg
              id="history-chart"
              viewBox="0 0 480 64"
              role="img"
              aria-label="People viewing memes each round"
            >
              <path d="M0 60 H480" stroke="currentColor" opacity=".2" />
            </svg>
            <p id="activity-text">
              Nothing is moving yet. Every idea starts somewhere.
            </p>
          </div>
        </section>
        <aside class="side-panel">
          <section id="global-controls">
            <div class="panel-heading">
              <div>
                <span class="eyebrow">02 / YOUR NEXT MOVE</span>
                <h2>Make a little noise.</h2>
              </div>
            </div>
            <form id="meme-form">
              <label class="field-label" for="meme-name">
                Meme name
              </label>
              <input
                id="meme-name"
                maxlength="48"
                required
                value="Just one more cat video"
              />
              <fieldset>
                <legend>Pick your themes</legend>
                <div class="theme-options">
                  {THEMES.map((theme) => (
                    <label>
                      <input
                        type="checkbox"
                        name="theme"
                        value={theme}
                        checked={theme === 'animals'}
                      />
                      <span>{theme}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <fieldset>
                <legend>Find its personality</legend>
                {ATTRIBUTES.map((attribute, i) => (
                  <label class="slider-label" for={`attribute-${i}`}>
                    <span>{attribute}</span>
                    <output id={`attribute-value-${i}`}>
                      {[75, 50, 10, 35][i]}%
                    </output>
                    <input
                      id={`attribute-${i}`}
                      type="range"
                      min="0"
                      max="100"
                      value={[75, 50, 10, 35][i]}
                    />
                  </label>
                ))}
              </fieldset>
              <details>
                <summary>Template settings</summary>
                <label class="slider-label">
                  Immutability{' '}
                  <input
                    id="immutability"
                    type="range"
                    min="0"
                    max="100"
                    value="35"
                  />
                </label>
                <label class="slider-label">
                  Shareability{' '}
                  <input
                    id="shareability"
                    type="range"
                    min="0"
                    max="100"
                    value="85"
                  />
                </label>
                <p class="help">
                  Lower immutability makes remixes cheaper. Higher shareability
                  helps an idea travel.
                </p>
              </details>
              <button type="submit" id="launch" class="primary wide">
                Launch meme <span>20 compute ↗</span>
              </button>
              <p class="help">
                Seeds 8 people with matching interests. Advance a round to see
                their reactions.
              </p>
            </form>
            <div class="recommendation">
              <label class="field-label" for="recommendation">
                Shape the feed
              </label>
              <select id="recommendation">
                <option value="balanced">
                  Balanced · equal follow priorities
                </option>
                <option value="interests">
                  Familiar territory · similar interests
                </option>
                <option value="discovery">
                  Discovery · different interests
                </option>
              </select>
              <p class="help">
                Redistribute public-feed attention. Friend priorities stay
                fixed.
              </p>
            </div>
          </section>
          <section id="person-panel" hidden>
            <div class="panel-heading">
              <div>
                <span class="eyebrow">02 / UNDER THE SURFACE</span>
                <h2 id="person-title">Person</h2>
              </div>
              <button id="close-person" class="quiet">
                Back ×
              </button>
            </div>
            <div id="person-details"></div>
            <button id="seed-person" class="primary wide">
              Launch draft to this person · 20
            </button>
          </section>
          <section class="meme-library">
            <div class="section-label">
              <h3>Your meme ecosystem</h3>
              <span id="meme-count">0 memes</span>
            </div>
            <label class="sr-only" for="selected-meme">
              Inspect meme
            </label>
            <select id="selected-meme">
              <option value="">No memes yet</option>
            </select>
            <div id="meme-details">
              <p class="help">
                Originals and community remixes will appear here.
              </p>
            </div>
            <button id="edit-meme" class="quiet wide" disabled>
              Apply draft attributes · 12 compute
            </button>
          </section>
        </aside>
      </div>
      <p id="message" role="status" aria-live="polite">
        Ready when you are. Create a meme, then advance the round.
      </p>
      <footer>
        <p>
          <strong>MEME INC.</strong> A sandbox for the social life of ideas.
        </p>
        <form id="network-form">
          <label for="seed">Seed</label>
          <input
            id="seed"
            type="number"
            min="0"
            max="4294967295"
            value="42"
            required
          />
          <label class="sr-only" for="size">
            Population size
          </label>
          <select id="size">
            <option value="100">100 people</option>
            <option value="300" selected>
              300 people
            </option>
            <option value="1000">1,000 people</option>
            <option value="10000">10,000 people</option>
          </select>
          <button class="quiet" type="submit">
            New network ↺
          </button>
        </form>
        <small>
          New network clears the current game. Progress lives in this tab.
        </small>
      </footer>
    </main>
    <noscript>
      This simulation needs JavaScript. Enable JavaScript to create memes and
      explore the network.
    </noscript>
    <script>
      import '../lib/app';
    </script>
  </body>
</html>
